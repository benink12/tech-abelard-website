# Tech Abélard OS — this site has no database of its own. Every real write
# path forwards server-side to OS's internal API, which owns the actual
# records: "Request Live Access" (src/app/api/request-access), the
# /showcase/access gate (src/app/api/showcase/validate), the Contact form
# (src/app/api/contact), and Instant Audit persistence
# (src/lib/audit/osStore.ts). The OS never accepts any of these calls from
# a browser directly.
#
# The base URL of that OS instance's API. Defaults to
# http://localhost:3010 for local dev (see that repo's README for how to
# run it on that port) — set to the real OS deployment's origin in
# production.
OS_API_BASE_URL=http://localhost:3010

# Shared secret authenticating every server-to-server call to the OS above
# (see this repo's src/lib/portfolioAccess/osClient.ts, src/lib/audit/
# osStore.ts, src/app/api/contact, and the OS's src/lib/portfolioAccess/
# internalAuth.ts). Same value must be set here and as
# PORTFOLIO_ACCESS_INTERNAL_KEY in the OS repo's .env.local. Generate with:
#   openssl rand -base64 32
PORTFOLIO_ACCESS_INTERNAL_KEY=

# Signs the private showcase's session cookie (src/lib/showcase/session.ts)
# after a successful /showcase/access entry. Server-only. Generate with:
#   openssl rand -base64 32
SHOWCASE_SESSION_SECRET=

# Live interactive-demo URLs for the private /showcase/[slug] gate
# (src/lib/showcase/demoUrls.ts). Each is optional and independent — an
# unset entry makes that project's showcase page show an honest "Live demo
# opening soon" state instead of a link, rather than falling back to a
# local-dev-only address a real approved visitor could never reach. Set
# each one only once that project has a real, deployed URL.
DEMO_URL_NORTHLINE_PLUMBING=
DEMO_URL_NORTHCLIMATE_HVAC=
DEMO_URL_NORTHPEAK_ROOFING=
